# Copy this file to .env and fill in your values
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://mitto:mitto@localhost:15432/mitto
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-min-32-characters-long
JWT_EXPIRES_IN=7d
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App — connects orgs/repos (separate from the OAuth login above)
# Create at https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=

TF_CLOUD_TOKEN=
TF_CLOUD_ORG=mitto-sh
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ECR_REGISTRY=
PLATFORM_DOMAIN=http://localhost:3000
DASHBOARD_URL=http://localhost:3001
ENCRYPTION_KEY=change-me-min-32-characters-long
